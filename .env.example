# Optional Role 3 direct REST integration (kv branch).
# The app remains fully functional with deterministic fixtures when unset.
VITE_ROLE3_API_URL=http://localhost:8080

# Optional Role 1 agent query endpoint (Vishal branch).
# Role 1 must expose an HTTP endpoint that accepts:
# { "intent": "...", "incident_id": "INC-2407-001", "batch_id": "B-2407-184" }
VITE_ROLE1_AGENT_URL=http://localhost:3000/api/agent/query
