# Leave blank for the default same-origin /api routes. During `npm run dev`,
# Vite proxies them to the integrated ForgeOps API on port 8787.
VITE_FORGEOPS_API_URL=

# Backward-compatible overrides remain supported:
# VITE_ROLE3_API_URL=http://localhost:8787
# VITE_ROLE1_AGENT_URL=http://localhost:8787/api/agent/query
